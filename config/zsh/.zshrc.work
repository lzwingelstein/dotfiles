# Linux (travail)

# gvm uniquement en shell interactif : en non-interactif (ex. outils Claude Code)
# ses fonctions polluent la sortie (setValueForKeyFakeAssocArray: _encode not found)
[[ -o interactive ]] && [[ -s "$HOME/.gvm/scripts/gvm" ]] && source "$HOME/.gvm/scripts/gvm"

export PATH="$HOME/.opencode/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"
