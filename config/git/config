[alias]
 logg = log --oneline --graph --decorate \
  --format='%C(red)%h%C(reset) %C(bold yellow)%d%C(reset) %s %C(dim white)— %C(green)%an%C(reset) %C(blue)(%ar)%C(reset)'
 co = checkout
 st = status
 feat   = "!git checkout -b feat/$1 #"
 fix    = "!git checkout -b fix/$1 #"
 chore  = "!git checkout -b chore/$1 #"
 docs   = "!git checkout -b docs/$1 #"
 refact = "!git checkout -b refactor/$1 #"
	split = "!f() { local cur new stashed; cur=$(git branch --show-current); new=\"$1\"; if [ -z \"$new\" ]; then echo \"usage: git split <new-branch>\" >&2; return 1; fi; if [ -z \"$cur\" ]; then echo \"erreur: pas sur une branche (HEAD detache)\" >&2; return 1; fi; stashed=0; if [ -n \"$(git status --porcelain --untracked-files=all)\" ]; then git stash push -u -m \"split:$new\" || return 1; stashed=1; fi; git checkout -b \"$new\" || return 1; if [ \"$stashed\" = \"1\" ]; then git stash pop || return 1; fi; git fetch origin \"$cur\" || return 1; git branch -f \"$cur\" \"origin/$cur\" || return 1; echo \"OK: branche '$cur' remise a origin/$cur (HEAD reste sur '$new' avec tes changements)\"; }; f"
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true

[gpg]
	format = ssh
[commit]
	gpgsign = true
